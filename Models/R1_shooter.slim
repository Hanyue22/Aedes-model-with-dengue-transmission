//// RULES FOR FITNESS AFFECT FECUNDITY BASED ON GENOTYPE.
function (f$)fecundityFitness(o<Individual>$ ind) {
	 species_A = ind.countOfMutationsOfType(m5);
    
    if (species_A){
    	if (ind.sex == "F"){
    		somatic = SOMATIC_FITNESS_MULTIPLIER_F_1;
    		r1_somatic = SOMATIC_FITNESS_MULTIPLIER_F_2;
    		}
    	else{
    		somatic = SOMATIC_FITNESS_MULTIPLIER_M_1;
    		r1_somatic = SOMATIC_FITNESS_MULTIPLIER_M_2;
    		}
    }
    else{
    	if (ind.sex == "F")
    		somatic = SOMATIC_FITNESS_MULTIPLIER_F_2;
    	else
    		somatic = SOMATIC_FITNESS_MULTIPLIER_M_2;}

	 fecundity = 1.0;
	 
	 // Check two chromosomes:
	 for (locus in 1:DRIVE_NUMBER){
	 	drive_on_1 = ind.genome1.containsMarkerMutation(m2, locus);
	 	drive_on_2 = ind.genome2.containsMarkerMutation(m2, locus);
	 	drive_r1_on_1 = ind.genome1.containsMarkerMutation(m7, locus);
	 	drive_r1_on_2 = ind.genome2.containsMarkerMutation(m7, locus);
	 	wt_1 = ind.genome1.containsMarkerMutation(m1, locus);
	 	wt_2 = ind.genome2.containsMarkerMutation(m1, locus);
	 	r1_1 = ind.genome1.containsMarkerMutation(m3, locus);	
	 	r1_2 = ind.genome2.containsMarkerMutation(m3, locus); 
    
	   if (drive_on_1 | drive_on_2)
        if (wt_1 | wt_2)     
    			fecundity = somatic * fecundity;
    			
    	if (drive_r1_on_1 | drive_r1_on_2)
    	  if (r1_1 | r1_2)
    	  		fecundity = r1_somatic * fecundity;
    	}
      				      
    return fecundity;
}

//// FUNCTION FOR EVALUATING INFERTILITY CAUSED BY SUPRESSION DRIVES.
function (logical)isInfertile(o<Individual>$ ind) {

	 if (ind.sex == "F"){
	 
	 	for (locus in 1:DRIVE_NUMBER){
	 		A = ind.genome1.containsMarkerMutation(m2, locus)|ind.genome1.containsMarkerMutation(m4, locus)|ind.genome1.containsMarkerMutation(m7, locus);
	 		B = ind.genome2.containsMarkerMutation(m2, locus)|ind.genome2.containsMarkerMutation(m4, locus)|ind.genome2.containsMarkerMutation(m7, locus);
	 		
	 		if (A & B)
	 			return T;
	 	}
    }  
    return F;
}

//SEASONAL Function
function (float)SEASONAL(integer gen, integer duration) {
	now_gen = gen % 52;
	if ((now_gen < 25.5 - duration / 2)|(now_gen > 25.5 + duration / 2))
		return 0.0;
	else
		return 0.5 + cos((now_gen - 25.5) * 2 * PI / duration) / 2;
}

//SEASONAL Function for introducing dengue patient
function (float)LessSEASONAL(integer gen) {
	now_gen = gen % 52;
	return (cos((now_gen-51/2)*2*PI/51) + 1) / 2;
}

// Function to detect and store genotypes in a dictionary
function (object<Dictionary>$)setTag(o<Individual>$ ind, [l maternal = T]) {
    // Initialize a dictionary to store genotypes
    genotypeDict = Dictionary();
    value = 0;
    if (maternal){
    // Iterate through loci from 1 to DRIVE_NUMBER
    	for (locus in 1:DRIVE_NUMBER) {
        
        // Check the maternal chromosome (genome1) for mutations
        if (ind.genome1.containsMarkerMutation(m1, locus))
            value = 1;
        else if (ind.genome1.containsMarkerMutation(m2, locus))
            value = 2;
        else if (ind.genome1.containsMarkerMutation(m3, locus))
            value = 3;
        else if (ind.genome1.containsMarkerMutation(m4, locus))
            value = 4;
        else if (ind.genome1.containsMarkerMutation(m7, locus))
            value = 7;
        
        genotypeDict.setValue(asString(locus), value);}}
        
    else{
    	for (locus in 1:DRIVE_NUMBER) {   
        // Check the paternal chromosome (genome2) for mutations
        if (ind.genome2.containsMarkerMutation(m1, locus))
            value = 1;
        else if (ind.genome2.containsMarkerMutation(m2, locus))
            value = 2;
        else if (ind.genome2.containsMarkerMutation(m3, locus))
            value = 3;
        else if (ind.genome2.containsMarkerMutation(m4, locus))
            value = 4;
        else if (ind.genome2.containsMarkerMutation(m7, locus))
            value = 7;
            
        genotypeDict.setValue(asString(locus), value);}}
    
    return genotypeDict;
}


