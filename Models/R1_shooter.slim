    	 for (locus in loci_with_m7) {
        
        // Check if chromosome has R1 allele at this locus.
        if (!child_chromosome.containsMarkerMutation(m3, locus))
            next;

        // Apply homing effect.
        if (runif(1) < conversion_rate)
