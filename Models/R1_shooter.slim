adult_f_B = adult_f[adult_f.countOfMutationsOfType(m6) > 0];
adult_m_A = adult_m[adult_m.countOfMutationsOfType(m5) > 0];
adult_m_B = adult_m[adult_m.countOfMutationsOfType(m6) > 0];

// First, species A find mate, bite and reproduce.
for (female_A in adult_f_A){

    // Check to see if this female is infertile because of drive mechanics:
    if (isInfertile(female_A))
        next;

    if (female_A.tag == 0 | runif(1) < REMATE_CHANCE)
        // Individual has not yet mated, or want to remate.       
        if (size(adult_m_A) > 0) {
            // Females choose a random provisional mate, but make a final mating decision based on the
            // attractiveness of that mate, as determined by the fitness of the mate. If a mate is
            // rejected, the female tries again, up to a maximum number of tries, after which she gives up.
            attempt_no = 0;
            found_mate = F;
            while (1) {
                mate_no = 0;
                if (size(adult_m_A) > 1)
                    mate_no = rdunif(1, max=size(adult_m_A) - 1);
                selected_mate = adult_m_A[mate_no];
                // Determine attractiveness of potential mate.
                mate_attractiveness = fecundityFitness(selected_mate);
                // Determine if this mate is chosen, based on attractiveness.
                if (runif(1) < mate_attractiveness) {
                    found_mate = T;
                    break;  // Select this mate.
                }
                // After ten candidates fail, female gives up.
                attempt_no = attempt_no + 1;
                if (attempt_no == MAX_ATTEMPTS_TO_FIND_SUITABLE_MATE)
                    break;
            }
            if (found_mate) {
                // Mate has now been selected, record his genotype.
                female_A.setValue("maternal", setTag(selected_mate, maternal = T));
                female_A.setValue("paternal", setTag(selected_mate, maternal = F));
                female_A.tag = 1;
                // Check to see if mate is infertile because of drive mechanics.
                // tagF holds the somatic fitness multiplier of the mate.
                if (isInfertile(selected_mate)) {
                	female_A.tagF = 100.0;
                  next;}
                // Check to see if male somatic fitness penalty will decrease number of offspring. Fecundity effected only in offspring of D/+ males.
               
	             if (selected_mate.countOfMutationsOfType(m1) & selected_mate.countOfMutationsOfType(m2))
                  female_A.tagF = SOMATIC_FITNESS_MULTIPLIER_M_1;
                }
            }
        
	 // Females bite.
	 humans = p100.individuals;
	 n_humans = length(humans);
	 if (n_humans == 0)
			next; // Female doesn't bite or reproduce.
	 else if (runif(1) > AEGYPTI_BITING)
	 		next; // Female doesn't want to bite.
	 else{
			human = humans[rdunif(1, 0, n_humans-1)];
			
	 		// Dengue transmission.
		 	Host = human.getValue("Dengue");
		 	Vector = female_A.getValue("Dengue");
		 	HostType = human.getValue("Serotype");
		 	VectorType = female_A.getValue("Serotype");
		 	HostImmunity = human.getValue("Immunity");
		 	Cross = human.getValue("CrossImmunity");
		 	InfectionCounts = human.getValue("Counts");
		 	
			if (Cross == 0) // Host doesn't has short-term cross-immunity.						 			 	
		 		if (Host == 0) // Host is not infected/infective.	
					if (Vector >= 1 + EXCUBATION){ // Vector is infected and infective.
						if (!any(HostImmunity == VectorType) | runif(1) < REINFACTION) // Host is not immune to this serotype.
							if (runif(1) < V_H_RATE){ // Host is unlucky engough.
								human.setValue("Dengue", 1); // Host is infected.
								human.setValue("Serotype", VectorType);
								human.setValue("Immunity", c(VectorType, HostImmunity)); // Host get long-term immunity to this serotype.
								human.setValue("CrossImmunity", CROSS_IMMUNITY); // Host get short-term cross-immunity to all strains.
								InfectionCounts = InfectionCounts + 1;
								human.setValue("Counts", InfectionCounts); 
							}
					}
				
				// If Host = 1, infected but not infective, nothing happens.			
			
				if (Host >= (1 + EXCUBATION)) // Host is infected and infective.						
					if (Vector == 0) // Vector is not infected/infective.
						if (runif(1) < H_V_RATE){ // Vector is unlucky engough.
							female_A.setValue("Dengue", 1); // Vector is infected.
							female_A.setValue("Serotype", HostType);
						}
			
    } // End of biting and disease transmission.
    
        
	 // Start to reproduce.
	 
    // Check to see if mate was infertile because of drive mechanics.
    if (female_A.tagF == 100.0)
        next;

    if (female_A.tag != 0) {
        // Individual has mated, and may lay eggs.
		  
	     selected_mate = sample(p3.individuals, 1);

        // Fecundity is based on female fitness.
        // Number of offspring number based on binomial distrobution.
        num_offspring = rpois(1, BETAMAX * 2);
        num_offspring = num_offspring * fecundityFitness(female_A);
        
        if (GL_RUN)
            num_offspring = num_offspring / BONUS_POP_FACTOR;

        num_offspring = asInteger(round(num_offspring));
        for (i in seqLen(num_offspring)) {
        // Add offspring to the subpopulation.
        	subpop.addCrossed(female_A, selected_mate);}
	}
}   

// Then, species B find mate, bite and reproduce.

for (female_B in adult_f_B){

