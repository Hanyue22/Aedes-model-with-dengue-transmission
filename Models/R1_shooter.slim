    for (locus in 1:DRIVE_NUMBER) {
        // Check father's genotype at this locus.
        loci = asString(locus);
        if (maternal.getValue(loci) != 7 & paternal.getValue(loci) != 7 )
            next;  // No drive allele at this locus, skip.

        // Check if child chromosome has R1 allele at this locus.
        if (!child_chromosome.containsMarkerMutation(m3, locus))
