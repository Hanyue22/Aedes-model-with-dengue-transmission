// This is a special version of the suppression model, where we release a second drive targeting R1 alleles from the first suppression drive. We're assuming there's only one kind of R1 allele (because we already tried hard enough to eliminate them by designing good gRNAs), and that the second drive will not generate R1 alleles itself. That said, the second drive will only cut R1 alleles, copying itself (homing) or generating nonfunctional resistance alleles (equal as original R2 alleles), or do nothing. It sits at the identical locus as the original drive, so it also leads to recessive female sterility.

// General life cycle of Aedes: Age 0 = offspring, tough competition; Age 1 = pupa/young adult, don't contribute to competition or mate; Age >= 2, mate and reproduce.
// "genotype fitness" influences offspring viability, and "fecundity fitness" influences female fecundity / male mating attractiveness.

// Vector.tag of females: 0 = not mated; 1 = mated.
// Vector(female).getValue("maternal/paternal"):stores the genotype of selected mate, just like how female mosquito stores the semen.
// Vector.tagF: stores the fecundity fitness of selected mate. 

// Vector.getValue("Dengue"): 0 = not infective / infected, 1 = infected, not infective, 1 + EXCUBATION = infected & infective.
// Vector.getValue("Serotype"): infected virus serotype.

// Host.getValue("Immunity"): a vector that storse long-term immunity to certain serotypes, c(0) is applied at first to avoid bugs.
// Host.getValue("Serotype"): infected virus serotype.
// Host.getValue("Dengue"): 0 = not infective / infected; 1 = infected, not infective; 1 + INCUBATION = infected & infective; 1 + INCUBATION + CURE_WEEKS = not infective / infected, reset to 0.
// Host.getValue("CrossImmunity"): short-term immunity to all serotypes, set to 20 when host is infected and declines overtime.
// Host.getValue("Counts"): counts of infection.
species all initialize() {
	 
	 // To avoid weird bugs. Don't ask what it is.
	 defineGlobal("ID", 100);

    // Modify the number of offspring to calc the genetic load.
    defineCfgParam("GL_RUN", F);
    defineConstant("BONUS_POP_FACTOR", 1.0);
    defineConstant("PREV_BONUS_POP_FACTOR", 1.0);
    defineConstant("ACTUAL_LARVAE", 0);

    // Shared Ecology:
    defineCfgParam("BITING", 1.0);
    defineCfgParam("REMATE_CHANCE", 0.05);
    defineCfgParam("BETAMAX", 15); // 2 * BETAMAX is the average offspring number of one wild-type female in a timestep.
    defineCfgParam("FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK", BITING);    
    defineConstant("FEMALE_WEEKS_OF_GENERATION", 6); // This is maximum adult life span.
    defineConstant("MALE_WEEKS_OF_GENERATION", 4); // This is maximum adult life span.
    	// This is a factor to equalize males and females of age 1, in spite of the different age distribution due to different life span.
    	normalize = (MALE_WEEKS_OF_GENERATION + 1) / (FEMALE_WEEKS_OF_GENERATION + 1);  
    
    defineConstant("INITIAL_FEMALE_AGE_DISTRIBUTION", c(FEMALE_WEEKS_OF_GENERATION,FEMALE_WEEKS_OF_GENERATION:1)/sum(1:FEMALE_WEEKS_OF_GENERATION));
    defineConstant("FEMALE_LIFESPAN", sum(c(1:FEMALE_WEEKS_OF_GENERATION)*INITIAL_FEMALE_AGE_DISTRIBUTION[1:FEMALE_WEEKS_OF_GENERATION]));// This is average adult life span.
	 defineConstant("INITIAL_MALE_AGE_DISTRIBUTION", c(MALE_WEEKS_OF_GENERATION,MALE_WEEKS_OF_GENERATION:1)/sum(1:MALE_WEEKS_OF_GENERATION) * normalize);
    defineConstant("MALE_LIFESPAN", sum(c(1:MALE_WEEKS_OF_GENERATION)*INITIAL_MALE_AGE_DISTRIBUTION[1:MALE_WEEKS_OF_GENERATION]));// This is average adult life span.
    	survival_rate_m = c(1);
				for (i in 1:MALE_WEEKS_OF_GENERATION){
    				survival_rate_m = c(survival_rate_m, (MALE_WEEKS_OF_GENERATION - i)/(MALE_WEEKS_OF_GENERATION + 1 - i));}
    	survival_rate_f = c(1);
				for (i in 1:FEMALE_WEEKS_OF_GENERATION){
    				survival_rate_f = c(survival_rate_f,(FEMALE_WEEKS_OF_GENERATION - i)/(FEMALE_WEEKS_OF_GENERATION - i + 1));}
    defineConstant("SURVIVE_RATE_M", survival_rate_m);
    defineConstant("SURVIVE_RATE_F", survival_rate_f);
    
    
    // Capacity:
    defineCfgParam("NUM_ADULT_FEMALES", 4000);
    defineGlobal("TOTAL_FEMALES", NUM_ADULT_FEMALES + (FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK * BETAMAX + INITIAL_FEMALE_AGE_DISTRIBUTION[0]) * NUM_ADULT_FEMALES);
    defineConstant("CALC_INITIAL_FEMALE_AGE", sum(INITIAL_FEMALE_AGE_DISTRIBUTION) + FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK * BETAMAX);
    defineConstant("CALC_INITIAL_MALE_AGE", sum(INITIAL_MALE_AGE_DISTRIBUTION) + FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK * BETAMAX);    
    defineCfgParam("CAPACITY", TOTAL_FEMALES + TOTAL_FEMALES * CALC_INITIAL_MALE_AGE / CALC_INITIAL_FEMALE_AGE); 
    
	 // Exclusive ecology:
	 // Vector A: 	 
	 defineCfgParam("AEGYPTI_PORTION", 2.0);
	 defineCfgParam("AEGYPTI_CAPACITY", AEGYPTI_PORTION * CAPACITY);
	 defineCfgParam("AEGYPTI_BITING", BITING);
	 // Vector B:
	 defineCfgParam("ALBOPICTUS_PORTION", 0.0);
	 defineCfgParam("ALBOPICTUS_CAPACITY", ALBOPICTUS_PORTION * CAPACITY);
	 defineCfgParam("ALBOPICTUS_BITING", BITING);
	 // Host:
	 defineCfgParam("HUMAN_POPULATION", 10000);
	 defineCfgParam("DECREASE", 0.00075);
	 defineCfgParam("INCREASE", 0.00085);
	 defineCfgParam("INITIAL_DENGUE", 0.000);// People who are currently infected.
	 defineCfgParam("HISTORICAL_DENGUE", 0.8);// People who had been infected.
	 // Distribution of initial dengue. Sum == 1.
	 defineGlobal("INITIAL_DENGUE_1", 0.25);
	 defineGlobal("INITIAL_DENGUE_2", 0.25);
	 defineGlobal("INITIAL_DENGUE_3", 0.25);
	 defineGlobal("INITIAL_DENGUE_4", 0.25);
	 	  
	 // Dengue:
	 defineCfgParam("H_V_RATE", 0.4375); // Transmission rate from hosts to vectors.
	 defineCfgParam("V_H_RATE", 0.6); // Transmission rate from vectors to hosts.
	 defineCfgParam("EXCUBATION", 1); // Time for vectors to become infective after being transmitted.
	 defineCfgParam("INCUBATION", 1); // Time for hosts to become infective after being transmitted.
	 defineCfgParam("CURE_WEEKS", 1); // Time for hosts to cure and return healthy / uninfective.
	 defineCfgParam("CROSS_IMMUNITY", 16);	// A short-term immunnity to all dengue strains after infection.	 
	 defineCfgParam("WEEKLY_INTRODUCTION_RATE", 1.0); // The possibility of introduction of a dengue carrier.
	 defineCfgParam("INTRO_MOS", 0.0);
	 defineCfgParam("REINFACTION", 0.05);
	 
	 // Season:
	 defineCfgParam("SEASON", T);	 
	 defineCfgParam("SEASONAL_AMPLITUDE", 6.5);
	 defineCfgParam("SEASONAL_DURATION", 20); 
	 
	 // Track dengue introduction
	 defineGlobal("Intro_Mosquito", 0);// Track actual introduction
	 defineGlobal("Intro_Human", 0);// Track actual introduction
	 
    // Competition:
	 defineCfgParam("INTERSPECIFIC_COMP_FACTOR_A", 1.0); // A : MEANS THE EFFECT OF A TO B
	 defineCfgParam("INTERSPECIFIC_COMP_FACTOR_B", 1.0); // B : MEANS THE EFFECT OF B TO A
    defineGlobal("EXPECTED_COMPETITION_A", NUM_ADULT_FEMALES * AEGYPTI_PORTION * 2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK + ALBOPICTUS_PORTION * NUM_ADULT_FEMALES * 2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK * INTERSPECIFIC_COMP_FACTOR_B); // Expected competition of vector A: Aedes aegypti.
	 defineGlobal("EXPECTED_COMPETITION_B", NUM_ADULT_FEMALES * ALBOPICTUS_PORTION * 2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK + NUM_ADULT_FEMALES * AEGYPTI_PORTION * 2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK * INTERSPECIFIC_COMP_FACTOR_A); // Expected competition of vector B: Aedes albopictus.

	 // Drive types:
	 // Unfortunately, you can't define and modify drive types easily in this model. It is built specifically for the drives mentioned at the beginning.
	 // If you do want to model other kinds of drives, check and modify the mechanisms in the "modifyChild" callback, the "isInfertile" function and other sections CAREFULLY.
	 // BUT! GOOD NEWS! You can define parameters for each drive, respectively!
	 
	 // If you turn it OFF, nothing will be released, no matter how you set other parameters below.
	 defineCfgParam("DROP", T); 
	 
	 // Drive number: you can have many drives targeting different locus in one gene.
	 defineCfgParam("DRIVE_NUMBER", 1);// DON'T CHANGE IN THIS MODEL.
	 
	 // Drop time
	 defineCfgParam("DROP_TIME", 16);// The first time we release a drive. After that, another drive is released every 52 weeks, until all drives are released. 
	 
	 defineCfgParam("DROP_TIME_R1", 52);// It only controls the timepoint we release the second drive targeting R1. 	 
	 
	 // Drop interval
	 defineCfgParam("DROP_INTERVAL", 52);// NO USE IN THIS MODEL.
	 
	 // Drive parameters for drive 1 in species A:
	 defineCfgParam("DROP_1", 0.005);
	 defineCfgParam("DROP_SIZE_1", DROP_1 * CAPACITY);
	 defineCfgParam("DD_FITNESS_VALUE_1", 1.0);
	 defineCfgParam("DX_FITNESS_VALUE_1", sqrt(DD_FITNESS_VALUE_1));
	 defineCfgParam("DRIVE_CONVERSION_RATE_1", 0.8);
	 defineCfgParam("LATE_GERMLINE_RESISTANCE_CUT_RATE_1", 0.5);
	 defineCfgParam("EMBRYO_RESISTANCE_CUT_RATE_1", 0.1);
    defineCfgParam("SOMATIC_FITNESS_MULTIPLIER_F_1", 0.7);
    defineCfgParam("SOMATIC_FITNESS_MULTIPLIER_M_1", 1.0);
    defineCfgParam("R1_OCCURRENCE_RATE_1", 0.0);
    
    // Drive parameters for drive 2:
    // It now controls the efficiency of the drive targeting R1.
    defineCfgParam("DROP_2", 0.0);// DON"T CHANGE. WE'RE RELEASING SAME AMOUNT WITH DROP_1.
    defineCfgParam("DROP_SIZE_2", DROP_2 * CAPACITY);
	 defineCfgParam("DD_FITNESS_VALUE_2", 1.0);
	 defineCfgParam("DX_FITNESS_VALUE_2", sqrt(DD_FITNESS_VALUE_2));
	 defineCfgParam("DRIVE_CONVERSION_RATE_2", 0.9);
	 defineCfgParam("LATE_GERMLINE_RESISTANCE_CUT_RATE_2", 0.5);
	 defineCfgParam("EMBRYO_RESISTANCE_CUT_RATE_2", 0.1);
    defineCfgParam("SOMATIC_FITNESS_MULTIPLIER_F_2", 0.7);
    defineCfgParam("SOMATIC_FITNESS_MULTIPLIER_M_2", 1.0);
    defineCfgParam("R1_OCCURRENCE_RATE_2", 0.0);// DON'T CHANGE. NO USE. THE SECOND DRIVE DOES NOT GENERATE R1 ALLELES.
    
    // Ecology parameters:
    defineCfgParam("MAX_ATTEMPTS_TO_FIND_SUITABLE_MATE", 10);
    defineCfgParam("LOW_DENSITY_GROWTH_RATE", 6);
    defineCfgParam("HETEROZYGOUS_DROP", T);
    
	 // This simulation will use a non-Wright-Fisher model.
    initializeSLiMModelType("nonWF");
    }

	 // Set gene elements for Ades mosquitos	   
species vector initialize() {
	 
	 initializeSpecies(avatar = "V");  
	 
	 wt = initializeMutationType("m1", 0.5, "f", 0.0);
    dr = initializeMutationType("m2", 0.5, "f", 0.0);
    r1 = initializeMutationType("m3", 0.5, "f", 0.0);
    r2 = initializeMutationType("m4", 0.5, "f", 0.0);
    // A species mark.
    Aeg = initializeMutationType("m5", 0.5, "f", 0.0);
    Alb = initializeMutationType("m6", 0.5, "f", 0.0);
    
    // Second drive targeting m3.
    dr_r1 = initializeMutationType("m7", 0.5, "f", 0.0);
	   
	 variation1 = c(Aeg, Alb);  
	 variation2 = c(wt, dr, r1, r2, dr_r1);
	   
	 initializeGenomicElementType("g1", variation1, c(1, 1));
	 initializeGenomicElementType("g2", variation2, c(1, 1, 1, 1, 1));
	   
	 initializeGenomicElement(g1, 0, 0);
	 initializeGenomicElement(g2, 1, DRIVE_NUMBER);
	   
	 // These variations overwrite one another.
	 variation1.mutationStackPolicy = "l";
	 variation1.mutationStackGroup = 1;
	 
	 variation2.mutationStackPolicy = "l";
	 variation2.mutationStackGroup = 1;

	 // No mutation in this model.
	 initializeMutationRate(0.0);
			
	 // These two sites are unlinked.
	 initializeRecombinationRate(0.0);

	 // Simulate sexual reproduction: A for autosome.
	 initializeSex("A");

	 }
    
// Human settings.    
species host initialize() {
	 initializeSpecies(avatar = "H");}
	     
//// HELPER FUNC FOR CONSTANTS THAT MAY ASLO BE CONFIGURED VIA COMMAND LINE.
function (void)defineCfgParam(string$ name, lifs value) {
    if (!exists(name))
        defineConstant(name, value);
}

//// HELPER FUNCTION FOR FORMING A RESISTANCE ALLELE AT A GIVEN LOCUS.
function (void)addResistanceAllele(o<Genome>$ genome, i$ locus, f$ r1_rate) {
    // Resistance alleles form at a specified rate.
    // m3 is R1 allele, m4 is R2.
    if(runif(1) < r1_rate)
        genome.addNewDrawnMutation(m3, locus);
    else
        genome.addNewDrawnMutation(m4, locus);
}

//// For our second drive targeting R1, which should not generating other R1 alleles.
function (void)addResistanceAllele_R1(o<Genome>$ genome, i$ locus) {
    // Add R2 to original R1 locus
    genome.addNewDrawnMutation(m4, locus);
}
   
//// FUNCTION FOR CAS9 EFFECTS IN THE GERMLINE).
function (void)germline(o<Genome>$ child_chromosome, o<Individual>$ parent, f$ resistance_rate, f$ r1_rate, [l maleParent=F]) {

if (!maleParent){
	 	 loci_with_m2 = parent.genomes.positionsOfMutationsOfType(m2);  // Loci with drive allele (m2).    
    	 if (size(loci_with_m2) == 0)
    	 	return;
    	 for (locus in loci_with_m2) {
        
        // Check if chromosome has wild-type allele at this locus.
        if (!child_chromosome.containsMarkerMutation(m1, locus))
            next;
            
        if (runif(1) < resistance_rate)
            addResistanceAllele(child_chromosome, locus, r1_rate);}}
            
if (maleParent){

    // Retrieve father's genotype dictionary.
    maternal = parent.getValue("maternal");
	 paternal = parent.getValue("paternal");
    for (locus in 1:DRIVE_NUMBER) {
        // Check father's genotype at this locus.
        loci = asString(locus);
        if (maternal.getValue(loci) != 2 & paternal.getValue(loci) != 2 )
            next;  // No drive allele at this locus, skip.

        // Check if child chromosome has wild-type allele at this locus.
        if (!child_chromosome.containsMarkerMutation(m1, locus))
            next;

        // Apply Cas9 cutting and resistance formation.
        if (runif(1) < resistance_rate)
            addResistanceAllele(child_chromosome, locus, r1_rate);
    }
   }
}

//// For our second drive targeting R1.
function (void)germline_R1(o<Genome>$ child_chromosome, o<Individual>$ parent, f$ resistance_rate, [l maleParent=F]) {

if (!maleParent){
	 	 loci_with_dr_2 = parent.genomes.positionsOfMutationsOfType(m7);  // Loci with drive allele targeting R1 (m7).    
    	 if (size(loci_with_dr_2) == 0)
    	 	return;
    	 for (locus in loci_with_dr_2) {
        
        // Check if chromosome has R1 allele at this locus.
        if (!child_chromosome.containsMarkerMutation(m3, locus))
            next;
            
        if (runif(1) < resistance_rate)
            addResistanceAllele_R1(child_chromosome, locus);}}
            
if (maleParent){

    // Retrieve father's genotype dictionary.
    maternal = parent.getValue("maternal");
	 paternal = parent.getValue("paternal");
    for (locus in 1:DRIVE_NUMBER) {
        // Check father's genotype at this locus.
        loci = asString(locus);
        if (maternal.getValue(loci) != 7 & paternal.getValue(loci) != 7 )
            next;  // No drive allele targeting R1 at this locus, skip.

        // Check if child chromosome has R1 allele at this locus.
        if (!child_chromosome.containsMarkerMutation(m3, locus))
            next;

        // Apply Cas9 cutting and resistance formation.
        if (runif(1) < resistance_rate)
            addResistanceAllele_R1(child_chromosome, locus);
    }
   }
}

//// FUNCTION FOR CAS9 EFFECTS IN EMBRYO (USING MOTHER'S GENOTYPE).
function (void)embryo(o<Genome>$ child_chromosome, o<Individual>$ mother, f$ resistance_rate, f$ r1_rate) {

    // Check if mother has m2 at any locus.
    mother_loci_with_m2 = mother.genomes.positionsOfMutationsOfType(m2);  // Loci with drive allele (m2).

    if (size(mother_loci_with_m2) == 0)
        return;  // If no m2 allele exists, return.

    for (locus in mother_loci_with_m2) {
        // Check if child chromosome has wild-type allele (m1) at the same locus.
        if (!child_chromosome.containsMarkerMutation(m1, locus))
            next;

        // Apply Cas9 cutting and resistance formation at this locus.
        if (runif(1) < resistance_rate)
            addResistanceAllele(child_chromosome, locus, r1_rate);
    }
}

//// For our second drive targeting R1.
function (void)embryo_R1(o<Genome>$ child_chromosome, o<Individual>$ mother, f$ resistance_rate) {

    // Check if mother has m2 at any locus.
    mother_loci_with_m7 = mother.genomes.positionsOfMutationsOfType(m7);  // Loci with drive allele (m2).

    if (size(mother_loci_with_m7) == 0)
        return;  // If no m2 allele exists, return.

    for (locus in mother_loci_with_m7) {
        // Check if child chromosome has R1 allele (m3) at the same locus.
        if (!child_chromosome.containsMarkerMutation(m3, locus))
            next;

        // Apply Cas9 cutting and resistance formation at this locus.
        if (runif(1) < resistance_rate)
            addResistanceAllele_R1(child_chromosome, locus);
    }
}

//// FUNCTION FOR SIMULATING HOMOLOGY DIRECTED REPAIR (USING GENOTYPE DICTIONARY).
function (void)hdr(o<Genome>$ child_chromosome, o<Individual>$ parent, f$ conversion_rate, [l maleParent=F]) {

	 // For mother, simply check her genotype.
	 if (!maleParent){
	 	 loci_with_m2 = parent.genomes.positionsOfMutationsOfType(m2);  // Loci with drive allele (m2).    
    	 if (size(loci_with_m2) == 0)
    	 	return;
    	 for (locus in loci_with_m2) {
        
        // Check if chromosome has wild-type allele at this locus.
        if (!child_chromosome.containsMarkerMutation(m1, locus))
            next;

        // Apply homing effect.
        if (runif(1) < conversion_rate)
            child_chromosome.addNewDrawnMutation(m2, locus);}
    }
    
    // For father, check mother's tag	 	
    if (maleParent){
    maternal = parent.getValue("maternal");
	 paternal = parent.getValue("paternal");
    for (locus in 1:DRIVE_NUMBER) {
        // Check father's genotype at this locus.
        loci = asString(locus);
        if (maternal.getValue(loci) != 2 & paternal.getValue(loci) != 2 )
            next;  // No drive allele at this locus, skip.

        // Check if child chromosome has wild-type allele at this locus.
        if (!child_chromosome.containsMarkerMutation(m1, locus))
            next;

        // Apply homing effect.
        if (runif(1) < conversion_rate)
            child_chromosome.addNewDrawnMutation(m2, locus);}
    }
}

//// For our second drive targeting R1.
function (void)hdr_R1(o<Genome>$ child_chromosome, o<Individual>$ parent, f$ conversion_rate, [l maleParent=F]) {

	 // For mother, simply check her genotype.
	 if (!maleParent){
	 	 loci_with_m7 = parent.genomes.positionsOfMutationsOfType(m7);  // Loci with drive allele targeting R1 alleles (m7).    
    	 if (size(loci_with_m7) == 0)
