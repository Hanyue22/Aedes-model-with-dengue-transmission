//// START THE SIMULATION BY ADDING AN INITIAL WILD POPULATION.
ticks all 1 early() {
    // Start with a population of wild type flies.
    vector.addSubpop("p1", asInteger(AEGYPTI_CAPACITY), CALC_INITIAL_MALE_AGE / (CALC_INITIAL_FEMALE_AGE + CALC_INITIAL_MALE_AGE));
    A = p1.individuals;
    A.genomes.addNewDrawnMutation(m5, 0);
    
    for (locus in 1:DRIVE_NUMBER)
    	A.genomes.addNewDrawnMutation(m1, locus);
    

	 vector.addSubpop("p2", asInteger(ALBOPICTUS_CAPACITY), CALC_INITIAL_MALE_AGE / (CALC_INITIAL_FEMALE_AGE + CALC_INITIAL_MALE_AGE));	 
	 B = p2.individuals;
	 B.genomes.addNewDrawnMutation(m6, 0);
	 for (locus in 1:DRIVE_NUMBER)
    	B.genomes.addNewDrawnMutation(m1, locus);
    

    p1.takeMigrants(B);
    p2.removeSubpopulation();
    
    female_ages = size(INITIAL_FEMALE_AGE_DISTRIBUTION);
    male_ages = size(INITIAL_MALE_AGE_DISTRIBUTION);
    
    all = p1.individuals;
    
    for (ind in all) {
        if (ind.sex == "F") {
            ind.age = sample(0:female_ages, 1, F, c(FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK * BETAMAX, INITIAL_FEMALE_AGE_DISTRIBUTION));
        }
        else {
            ind.age = sample(0:male_ages, 1, F, c(FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK * BETAMAX, INITIAL_MALE_AGE_DISTRIBUTION));
        }
    }
    
    all.tag = 0;
    all.tagF = 1.0;
    all.setValue("Dengue", 0);
    all.setValue("Serotype", 0);

    vector.addSubpop("p3", 1, 1.0);
    p3.individuals.age = 5200;
    
    // Now set human subpop.
    host.addSubpop("p100", HUMAN_POPULATION);
	 humans = p100.individuals;
	 humans.age = 1;
	 // Set the dengue situation for everyone, healthy at first.
	 humans.setValue("Dengue", 0);
	 humans.setValue("Serotype", 0);
	 humans.setValue("Immunity", c(0));
	 humans.setValue("CrossImmunity", 0);
	 humans.setValue("Counts", 0); 
	 // A fraction of people is infected/had been infected with dengue.
	 current_infection = asInteger(INITIAL_DENGUE * HUMAN_POPULATION);
	 historical_infection = asInteger(HISTORICAL_DENGUE * HUMAN_POPULATION);
	 total_infection = current_infection + historical_infection;
	 
	 if (current_infection > 0){	 
	 	patients = p100.individuals[0:(current_infection - 1)];
	 	
	 	// Set their serotype and immunity.
	 	 
		for (patient in patients){
	 		serotype = 0;
	 		chance = runif(1);	
    		if (chance < INITIAL_DENGUE_1)
    			serotype = 1;
   		else if (chance < INITIAL_DENGUE_1 + INITIAL_DENGUE_2)
    			serotype = 2;
    		else if (chance < INITIAL_DENGUE_1 + INITIAL_DENGUE_2 + INITIAL_DENGUE_3)
    			serotype = 3;
    		else
    			serotype = 4;	 
		
	 	patient.setValue("Serotype", serotype);
	 	patient.setValue("Immunity", c(0, serotype));
	 	patient.setValue("Counts", 1);	 	
	 	
	 	// Now set their infection state.
	 	if (runif(1) < 0.5){
	 		// Half of them are in incubation period.
	 		patient.setValue("Dengue", 1);
	 		patient.setValue("CrossImmunity", CROSS_IMMUNITY);}
	 		// Half of them are infective.
	 	else{
	 		patient.setValue("Dengue", 2);
	 		patient.setValue("CrossImmunity", (CROSS_IMMUNITY - 1));}
	 	}
	 }	
	 	
	 if (historical_infection > 0){	
	 	historical_patients = p100.individuals[current_infection:(total_infection - 1)];
	 
	 	for (historical_patient in historical_patients){
	 		serotype = 0;
	 		chance = runif(1);	
    		if (chance < INITIAL_DENGUE_1)
    			serotype = 1;
   		else if (chance < INITIAL_DENGUE_1 + INITIAL_DENGUE_2)
    			serotype = 2;
    		else if (chance < INITIAL_DENGUE_1 + INITIAL_DENGUE_2 + INITIAL_DENGUE_3)
    			serotype = 3;
    		else
    			serotype = 4;	 
		
	 	historical_patient.setValue("Serotype", serotype);
	 	historical_patient.setValue("Immunity", c(0, serotype));
	 	historical_patient.setValue("Counts", 1);	 	
	 	
	 	// Now set their infection state.

	 	historical_patient.setValue("Dengue", 0);
	 	historical_patient.setValue("CrossImmunity", 0);
	 	
	 	}
	 }
}

//// DROP A GROUP OF MODIFIED INDIVIDUALS INTO THE POPULATION.
ticks all first() {

	 if(!DROP)
	 	return;
	 
	 if(vector.cycle < DROP_TIME)
	 	return;
	 	
	 if((vector.cycle - DROP_TIME)%DROP_INTERVAL != 0)
		return;

	 index = asInteger((vector.cycle - DROP_TIME)/DROP_INTERVAL + 1);	 
	 
	 if(index > DRIVE_NUMBER)
		return;
	 
	 subpop_id_A = asInteger(4 + 2*(index - 1));
	 
	 subpop_id_B = subpop_id_A + 1;
	 
    // Add a drop of modified species A individuals.   
    vector.addSubpop("p" + subpop_id_A, asInteger(DROP_SIZE_1), 1.0);
    drop1 = vector.subpopulations[2].individuals;
    drop1.age = 2;
    drop1.tag = 0;
    drop1.tagF = 1.0;
    // We don't really need to set these values since drop individuals are male. But to avoid potential bugs, set them.
	 drop1.setValue("Dengue", 0);
	 drop1.setValue("Serotype", 0);
    // Now set the drop individuals to the correct genotypes:
    drop1.genomes.addNewDrawnMutation(m5, 0);
    for (locus in 1:DRIVE_NUMBER)
    	drop1.genomes.addNewDrawnMutation(m1, locus);
	 drop1.genomes.addNewDrawnMutation(m2, index);

    // For heterozygous drop, one of the chromosomes is set to wild type:
    if (HETEROZYGOUS_DROP)
    	drop1.genome2.addNewDrawnMutation(m1, index);
	 
	 // Then add a drop of modified species B individuals.
	 vector.addSubpop("p" + subpop_id_B, asInteger(DROP_SIZE_2), 1.0);
    drop2 = vector.subpopulations[3].individuals;
    drop2.age = 2;
    drop2.tag = 0;
    drop2.tagF = 1.0;
	 drop2.setValue("Dengue", 0);
	 drop2.setValue("Serotype", 0);
    // Now set the drop individuals to the correct genotypes:
    drop2.genomes.addNewDrawnMutation(m6, 0);
	 for (locus in 1:DRIVE_NUMBER)
    	drop2.genomes.addNewDrawnMutation(m1, locus);
	 drop2.genomes.addNewDrawnMutation(m2, index);

    // For heterozygous drop, one of the chromosomes is set to wild type:
    if (HETEROZYGOUS_DROP)
    	drop2.genome2.addNewDrawnMutation(m1, index);

    // Now that genes have been set, move all the individuals from the drop into p1:
    p1.takeMigrants(drop1);
    p1.takeMigrants(drop2);
    vector.subpopulations[2].removeSubpopulation();
    vector.subpopulations[2].removeSubpopulation();// This should be subpopulations[3], but we removed one before, so it's now [2].
    
    catn("DROPPED" + " : " + vector.cycle);
    
}

ticks all first() {
	if (vector.cycle != DROP_TIME_R1)
		return;
	// Add a drop of modified species A individuals with drive targeting R1 allele.   
    vector.addSubpop("p99", asInteger(DROP_SIZE_1), 1.0);
    drop = p99.individuals;
    drop.age = 2;
    drop.tag = 0;
    drop.tagF = 1.0;
    // We don't really need to set these values since drop individuals are male. But to avoid potential bugs, set them.
	 drop.setValue("Dengue", 0);
	 drop.setValue("Serotype", 0);
    // Now set the drop individuals to the correct genotypes:
    drop.genomes.addNewDrawnMutation(m5, 0);    
	 drop.genomes.addNewDrawnMutation(m7, 1);
    // For heterozygous drop, one of the chromosomes is set to wild type:
    if (HETEROZYGOUS_DROP)
    	drop.genome2.addNewDrawnMutation(m3, 1);
    p1.takeMigrants(drop);
    p99.removeSubpopulation();}

//// AGE BASED SURVIVAL RULES / VIABILITY COMPETITION.
ticks all early() {
	 // First, apply survival rules for vectors.
    all = p1.individuals;
    new = all[all.age == 0];
    adults = all[all.age > 0];
    new_larvae_A = new[new.countOfMutationsOfType(m5) > 0];// Aedes aegypti.
    new_larvae_B = new[new.countOfMutationsOfType(m6) > 0];// Aedes albopictus.
    sum_new_larvae_A = size(new_larvae_A);
    sum_new_larvae_B = size(new_larvae_B);
    
    if ((SEASON)&(vector.cycle > 15)) {		
		now_gen = asInteger((vector.cycle - 15) % 52);
		adjust_female = NUM_ADULT_FEMALES * (1 + SEASONAL_AMPLITUDE * SEASONAL(now_gen, SEASONAL_DURATION));
		defineGlobal("EXPECTED_COMPETITION_A", adjust_female * AEGYPTI_PORTION * 2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK + ALBOPICTUS_PORTION * adjust_female * 2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK * INTERSPECIFIC_COMP_FACTOR_B);
	 	defineGlobal("EXPECTED_COMPETITION_B", adjust_female * ALBOPICTUS_PORTION * 2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK + adjust_female * AEGYPTI_PORTION * 2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK * INTERSPECIFIC_COMP_FACTOR_A);
		}
	 
	 total_competition_A = sum_new_larvae_A + sum_new_larvae_B * INTERSPECIFIC_COMP_FACTOR_B;
	 total_competition_B = sum_new_larvae_B + sum_new_larvae_A * INTERSPECIFIC_COMP_FACTOR_A;
	 competition_ratio_A = total_competition_A / EXPECTED_COMPETITION_A;
	 competition_ratio_B = total_competition_B / EXPECTED_COMPETITION_B;
	
    concave_A = 2 * INITIAL_FEMALE_AGE_DISTRIBUTION[0] * (LOW_DENSITY_GROWTH_RATE / (2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK) / ((LOW_DENSITY_GROWTH_RATE - 1) * competition_ratio_A + 1));
    
    linear_A = 2 * INITIAL_FEMALE_AGE_DISTRIBUTION[0] * (((1 - LOW_DENSITY_GROWTH_RATE) * competition_ratio_A) + LOW_DENSITY_GROWTH_RATE) / (2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK);
    
    concave_B = (LOW_DENSITY_GROWTH_RATE / (2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK) / ((LOW_DENSITY_GROWTH_RATE - 1) * competition_ratio_B + 1)) * (2 * INITIAL_FEMALE_AGE_DISTRIBUTION[0]);
    
    linear_B = 2 * INITIAL_FEMALE_AGE_DISTRIBUTION[0] * (((1 - LOW_DENSITY_GROWTH_RATE) * competition_ratio_B) + LOW_DENSITY_GROWTH_RATE) / (2 * BETAMAX * FRACTION_OF_FEMALES_THAT_REPRODUCE_PER_WEEK);
    
    if (competition_ratio_A > 1)
    	viability_A = concave_A;
    else
    	viability_A = 0.5 * (concave_A + linear_A);
    	
    if (competition_ratio_B > 1)
    	viability_B = concave_B;
    else
    	viability_B = 0.5 * (concave_B + linear_B);
   
    for (A in new_larvae_A) {
    	A.fitnessScaling = genotypeFitness(A) * viability_A;
    	A.setValue("Dengue", 0);
    	A.setValue("Serotype", 0);}
    for (B in new_larvae_B) {
    	B.fitnessScaling = genotypeFitness(B) * viability_B;
    	B.setValue("Dengue", 0);
    	B.setValue("Serotype", 0);}
	 
	 for (adult in adults){
	 	if (adult.sex == "M")
    		adult.fitnessScaling = genotypeFitness(adult) * SURVIVE_RATE_M[adult.age - 1];
    	else
    		adult.fitnessScaling = genotypeFitness(adult) * SURVIVE_RATE_F[adult.age - 1];	
    	}
}

