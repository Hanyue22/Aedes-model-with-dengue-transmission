}

//// HELPER FUNCTION TO OVERWRITE ONE GENOME WITH ANOTHER.
function (void)copy_genome(o<Genome>$ source, o<Genome>$ destination) {
    m1_loci = source.positionsOfMutationsOfType(m1);
    m2_loci = source.positionsOfMutationsOfType(m2);
    m3_loci = source.positionsOfMutationsOfType(m3);
    m4_loci = source.positionsOfMutationsOfType(m4);
    m5_loci = source.positionsOfMutationsOfType(m5);
    m6_loci = source.positionsOfMutationsOfType(m6);
    m7_loci = source.positionsOfMutationsOfType(m7);

    for (i in seqAlong(m1_loci))
        destination.addNewDrawnMutation(m1, m1_loci[i]);
    for (i in seqAlong(m2_loci))
        destination.addNewDrawnMutation(m2, m2_loci[i]);
    for (i in seqAlong(m3_loci))
        destination.addNewDrawnMutation(m3, m3_loci[i]);
    for (i in seqAlong(m4_loci))
        destination.addNewDrawnMutation(m4, m4_loci[i]);
    for (i in seqAlong(m5_loci))
        destination.addNewDrawnMutation(m5, m5_loci[i]);
    for (i in seqAlong(m6_loci))
        destination.addNewDrawnMutation(m6, m6_loci[i]);
    for (i in seqAlong(m7_loci))
        destination.addNewDrawnMutation(m7, m7_loci[i]);
}

// Define serotypes at the beginning of each year.
ticks all first() {
    if ((vector.cycle - 16) % 52 == 0) {
        print("SELECT");

        // Randomly select a dominance serotype (1, 2, 3, or 4)
        dominanceSerotype = sample(c(1,2,3,4), 1);

        // Assign the dominance serotype a random proportion between 0.5 and 1
        dominanceProportion = runif(1, 0.5, 1);

        // Initialize proportions for the remaining serotypes
        remainingProportion = 1 - dominanceProportion;
        remainingSerotypes = setDifference(c(1,2,3,4), c(dominanceSerotype));

        // Randomly distribute the remaining proportion using normalized random sampling
        randomValues = c(runif(1), runif(1), runif(1));
        sumValues = sum(randomValues);
        seroRemaining = (randomValues / sumValues) * remainingProportion;

        // Assign values based on dominance
        defineGlobal("INITIAL_DENGUE_" + dominanceSerotype, dominanceProportion);
        defineGlobal("INITIAL_DENGUE_" + remainingSerotypes[0], seroRemaining[0]);
        defineGlobal("INITIAL_DENGUE_" + remainingSerotypes[1], seroRemaining[1]);
        defineGlobal("INITIAL_DENGUE_" + remainingSerotypes[2], seroRemaining[2]);

        // Print results
        print("INITIAL_DENGUE_" + dominanceSerotype + " : " + dominanceProportion);
        print("INITIAL_DENGUE_" + remainingSerotypes[0] + " : " + seroRemaining[0]);
        print("INITIAL_DENGUE_" + remainingSerotypes[1] + " : " + seroRemaining[1]);
        print("INITIAL_DENGUE_" + remainingSerotypes[2] + " : " + seroRemaining[2]);
    }
}

// GENE DRIVE IMPLEMENTATION RULES THAT OCCUR IN EVERY CHILD.
species vector 1: modifyChild() {
    // Get father's genotype
    maternal = parent1.getValue("maternal");
    paternal = parent1.getValue("paternal");     
        
        if (runif(1) < 0.5) {
        	for (locus in 1:DRIVE_NUMBER) {
        	loci = asString(locus);   
            // Child inherits father's maternal chromosome.
            if (maternal.getValue(loci) == 1)
                child.genome2.addNewDrawnMutation(m1, locus);
            else if (maternal.getValue(loci) == 2)
                child.genome2.addNewDrawnMutation(m2, locus);
            else if (maternal.getValue(loci) == 3)
                child.genome2.addNewDrawnMutation(m3, locus);
            else if (maternal.getValue(loci) == 4)
                child.genome2.addNewDrawnMutation(m4, locus);
            else if (maternal.getValue(loci) == 7)
                child.genome2.addNewDrawnMutation(m7, locus);}
        } else {
        	for (locus in 1:DRIVE_NUMBER) {
        	loci = asString(locus);   
            // Child inherits father's paternal chromosome.
            if ((paternal.getValue(loci) == 1))
                child.genome2.addNewDrawnMutation(m1, locus);
            else if (paternal.getValue(loci) == 2)
                child.genome2.addNewDrawnMutation(m2, locus);
            else if (paternal.getValue(loci) == 3)
                child.genome2.addNewDrawnMutation(m3, locus);
            else if (paternal.getValue(loci) == 4)
                child.genome2.addNewDrawnMutation(m4, locus);
            else if (paternal.getValue(loci) == 7)
                child.genome2.addNewDrawnMutation(m7, locus);}
        }
    
	// Define child's species based on mother's species, and apply drive effects.
	   species_A = parent1.countOfMutationsOfType(m5);
	 //species_B = parent1.countOfMutationsOfType(m6); We don't actually need this.   		
  		
  		if(species_A){
  			if(DROP){
  			// First, homology directed repair allows for homing to occur.
      	hdr(child.genome1, parent1, DRIVE_CONVERSION_RATE_1); // Germ cells of mother.
      	hdr(child.genome2, parent1, DRIVE_CONVERSION_RATE_1, maleParent=T); // Germ cells of father, but based on mother's tag.
      	// For our second drive targeting R1
      	hdr_R1(child.genome1, parent1, DRIVE_CONVERSION_RATE_2); // Germ cells of mother.
      	hdr_R1(child.genome2, parent1, DRIVE_CONVERSION_RATE_2, maleParent=T); // Germ cells of father, but based on mother's tag.
         
         // Then resistance alleles form.
         germline(child.genome1, parent1, LATE_GERMLINE_RESISTANCE_CUT_RATE_1, R1_OCCURRENCE_RATE_1);
      	germline(child.genome2, parent1, LATE_GERMLINE_RESISTANCE_CUT_RATE_1, R1_OCCURRENCE_RATE_1, maleParent=T);
      	// For our second drive targeting R1
      	germline_R1(child.genome1, parent1, LATE_GERMLINE_RESISTANCE_CUT_RATE_2);
      	germline_R1(child.genome2, parent1, LATE_GERMLINE_RESISTANCE_CUT_RATE_2, maleParent=T);
         
         // Apply effects that happen in the embryo.
         embryo(child.genome1, parent1, EMBRYO_RESISTANCE_CUT_RATE_1, R1_OCCURRENCE_RATE_1);
         embryo(child.genome2, parent1, EMBRYO_RESISTANCE_CUT_RATE_1, R1_OCCURRENCE_RATE_1);
         // For our second drive targeting R1
         embryo_R1(child.genome1, parent1, EMBRYO_RESISTANCE_CUT_RATE_2);
         embryo_R1(child.genome2, parent1, EMBRYO_RESISTANCE_CUT_RATE_2);
         
         }
  			// Finally, add species mark.
  			child.genome1.addNewDrawnMutation(m5, 0);
         child.genome2.addNewDrawnMutation(m5, 0);
         }
         
      else{ // Apply parameters for species B.
      	if(DROP){       
      	// First, homology directed repair allows for homing to occur.
      	hdr(child.genome1, parent1, DRIVE_CONVERSION_RATE_2); // Germ cells of mother.
      	hdr(child.genome2, parent1, DRIVE_CONVERSION_RATE_2, maleParent=T); // Germ cells of father, but based on mother's tag.
         // Then resistance alleles form.
         germline(child.genome1, parent1, LATE_GERMLINE_RESISTANCE_CUT_RATE_2, R1_OCCURRENCE_RATE_2);
      	germline(child.genome2, parent1, LATE_GERMLINE_RESISTANCE_CUT_RATE_2, R1_OCCURRENCE_RATE_2, maleParent=T);
         // Apply effects that happen in the embryo.
         embryo(child.genome1, parent1, EMBRYO_RESISTANCE_CUT_RATE_2, R1_OCCURRENCE_RATE_2);
         embryo(child.genome2, parent1, EMBRYO_RESISTANCE_CUT_RATE_2, R1_OCCURRENCE_RATE_2);}
  			// Finally, add species mark.
  			child.genome1.addNewDrawnMutation(m6, 0);
         child.genome2.addNewDrawnMutation(m6, 0);
         }   
   
    child.tag = 0;
    child.tagF = 1.0;
    
    return T;
}

